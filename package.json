{
  "name": "space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "dev": "node scripts/dev.mjs",
    "predev": "vp run @space/protocol#build",
    "dev:desktop": "node scripts/dev.mjs",
    "predev:desktop": "vp run @space/protocol#build",
    "dev:runtime": "node scripts/dev.mjs runtime",
    "predev:runtime": "vp run @space/protocol#build",
    "test": "vp test run",
    "test:e2e": "vp run build && vp run @space/desktop#test:e2e",
    "test:package": "vp run build && vp run @space/desktop#package:dir && vp run @space/desktop#test:package",
    "typecheck": "vp check --no-fmt --no-lint",
    "package": "vp run build && vp run @space/desktop#package",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "eslint-plugin-playwright": "^2.11.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0"
}
